#include <iostream>
using namespace std;

void bubblesort(int arr[],int n ){
    for( int i = 0 ; i < n-1 ; i++){
        for( int j = 0 ; j < n-1-i ; j++){
            if ( arr[j] > arr[j+1]){
                swap(arr[j],arr[j+1]);
            }
        }
    } 
}
void printarray(int arr[], int n){
    for(int i = 0 ; i < n ; i++ ){
        cout<<arr[i]<<" ";
    }
    cout<<endl;
}

int main() {
    int arr[] = { 4, 1, 3, 5, 2};
    int n = 5;


    bubblesort(arr,n);

    printarray(arr,n);

    return 0;
}

