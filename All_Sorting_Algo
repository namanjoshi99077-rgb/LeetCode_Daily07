#include <iostream>
using namespace std;

void bubbleshort ( int arr[] , int n){
for(int i = 0 ; i < n-1; i++){
    for(int j = 0; j < n-i-1; j++){
        if(arr[j] > arr[j+1]){
            swap(arr[j], arr[j+1]);
        }

    }
    
}
}
void selectionsort(int arr[],int n){
    for( int i = 0 ; i < n-1 ; i++){
        int si = i;
        for(int j = i+1 ; j<n ; j++){
            if(arr[j] < arr[si]){
                si = j;
            }
        }
        swap(arr[i] , arr[si]);
    }
}
void insertionsort(int arr[], int n) {

    for(int i = 1; i < n; i++) {

        int cur = arr[i];
        int prev = i - 1;

        while(prev >= 0 && arr[prev] > cur) {

            arr[prev + 1] = arr[prev];
            prev--;

        }

        arr[prev + 1] = cur;
    }
}

void printarray(int arr[], int n){
    for(int i=0;i<n ; i++ ){
        cout<<arr[i]<< " ";
    }
    cout<<endl;
}

