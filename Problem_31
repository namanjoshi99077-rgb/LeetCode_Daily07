class Solution {
public:
    void nextPermutation(vector<int>& A) {
        int piv = -1 , n = A.size() - 1;
        for( int i = n-1 ; i >= 0 ; i-- ){
            if ( A[i] < A[i+1]){
                piv = i;
                break;
            }
        }

        if( piv == -1){
            reverse( A.begin() , A.end());
            return;
        }

        for( int i = n ; i > piv ; i--){
            if( A[piv] < A[i]){
                swap(A[piv] , A[i]);
                break;
            }
        }

        int a = piv + 1, p = n ;
        while( a < p){
            swap(A[a] , A[p]);
            a++;
            p--;
        }
        
    }
};
